<script>\
    // DOM Elements\
    const fileInput = document.getElementById('file-input');\
    const dropZone = document.getElementById('drop-zone');\
    const previewImage = document.getElementById('preview-image');\
    const emptyState = document.getElementById('empty-state');\
    const previewFilename = document.getElementById('preview-filename');\
    const clearPreviewBtn = document.getElementById('clear-preview');\
    const imageContainer = document.getElementById('image-container');\
    const zoomHint = document.getElementById('zoom-hint');\
    const recognizeBtn = document.getElementById('recognize-btn');\
    const btnSpinner = document.getElementById('btn-spinner');\
    const btnText = document.getElementById('btn-text');\
    const mockToggle = document.getElementById('mock-toggle');\
    const tableBody = document.getElementById('data-table-body');\
    const addRowBtn = document.getElementById('add-row-btn');\
    const totalAmountEl = document.getElementById('total-amount');\
    const clearTableBtn = document.getElementById('clear-table');\
    const historyList = document.getElementById('history-list');\
    const noHistoryState = document.getElementById('no-history-state');\
\
    let isMockEnabled = false;\
    let scale = 1;\
    let originX = 0;\
    let originY = 0;\
    let isDragging = false;\
    let startX, startY, currentX = 0, currentY = 0;\
\
    // Image Handling\
    fileInput.addEventListener('change', (e) => \{\
        const file = e.target.files[0];\
        if (file) handleFile(file);\
    \});\
\
    dropZone.addEventListener('dragover', (e) => \{\
        e.preventDefault();\
        dropZone.classList.add('border-primary');\
    \});\
\
    dropZone.addEventListener('dragleave', () => \{\
        dropZone.classList.remove('border-primary');\
    \});\
\
    dropZone.addEventListener('drop', (e) => \{\
        e.preventDefault();\
        dropZone.classList.remove('border-primary');\
        const file = e.dataTransfer.files[0];\
        if (file) handleFile(file);\
    \});\
\
    function handleFile(file) \{\
        const reader = new FileReader();\
        reader.onload = (e) => \{\
            previewImage.src = e.target.result;\
            previewImage.classList.remove('hidden');\
            emptyState.classList.add('hidden');\
            previewFilename.innerText = file.name;\
            resetImageTransform();\
            addToHistory(file.name, e.target.result);\
            zoomHint.style.opacity = '1';\
        \};\
        reader.readAsDataURL(file);\
    \}\
\
    function addToHistory(name, data) \{\
        if (noHistoryState) noHistoryState.remove();\
        const item = document.createElement('div');\
        item.className = 'p-2 rounded bg-white/5 flex gap-3 items-center hover:bg-white/10 cursor-pointer transition-colors border border-white/5';\
        item.innerHTML = `\
            <div class="w-10 h-10 rounded bg-black/40 flex-shrink-0 flex items-center justify-center overflow-hidden">\
                <img src="$\{data\}" class="w-full h-full object-cover">\
            </div>\
            <div class="flex-1 min-w-0">\
                <div class="text-label-sm truncate">$\{name\}</div>\
                <div class="text-[10px] text-outline-variant/60">$\{new Date().toLocaleString('zh-CN')\}</div>\
            </div>\
        `;\
        historyList.prepend(item);\
    \}\
\
    clearPreviewBtn.addEventListener('click', () => \{\
        previewImage.src = '';\
        previewImage.classList.add('hidden');\
        emptyState.classList.remove('hidden');\
        previewFilename.innerText = '\uc0\u31561 \u24453 \u19978 \u20256 ...';\
        zoomHint.style.opacity = '0';\
    \});\
\
    // Zoom & Pan\
    imageContainer.addEventListener('wheel', (e) => \{\
        if (!previewImage.src) return;\
        e.preventDefault();\
        const delta = e.deltaY > 0 ? -0.1 : 0.1;\
        const newScale = Math.min(Math.max(0.5, scale + delta), 5);\
        \
        const rect = imageContainer.getBoundingClientRect();\
        const x = e.clientX - rect.left - currentX;\
        const y = e.clientY - rect.top - currentY;\
        \
        currentX -= (x / scale) * (newScale - scale);\
        currentY -= (y / scale) * (newScale - scale);\
        scale = newScale;\
        \
        updateTransform();\
    \});\
\
    imageContainer.addEventListener('mousedown', (e) => \{\
        if (!previewImage.src) return;\
        isDragging = true;\
        startX = e.clientX - currentX;\
        startY = e.clientY - currentY;\
    \});\
\
    window.addEventListener('mousemove', (e) => \{\
        if (!isDragging) return;\
        currentX = e.clientX - startX;\
        currentY = e.clientY - startY;\
        updateTransform();\
    \});\
\
    window.addEventListener('mouseup', () => isDragging = false);\
\
    function updateTransform() \{\
        previewImage.style.transform = `translate($\{currentX\}px, $\{currentY\}px) scale($\{scale\})`;\
    \}\
\
    function resetImageTransform() \{\
        scale = 0.8;\
        currentX = 50;\
        currentY = 50;\
        updateTransform();\
    \}\
\
    // Recognition Logic\
    mockToggle.addEventListener('click', () => \{\
        isMockEnabled = !isMockEnabled;\
        mockToggle.classList.toggle('bg-primary-container', isMockEnabled);\
        mockToggle.querySelector('div').classList.toggle('translate-x-4', isMockEnabled);\
    \});\
\
    recognizeBtn.addEventListener('click', () => \{\
        if (!previewImage.src && !isMockEnabled) \{\
            alert('\uc0\u35831 \u20808 \u19978 \u20256 \u25991 \u20214 ');\
            return;\
        \}\
        \
        btnSpinner.classList.remove('hidden');\
        btnText.innerText = '\uc0\u27491 \u22312 \u35782 \u21035 ...';\
        recognizeBtn.disabled = true;\
\
        setTimeout(() => \{\
