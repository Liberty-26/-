            addRow();\
        \}\
    \});\
\
    document.getElementById('copy-table').addEventListener('click', () => \{\
        alert('\uc0\u34920 \u26684 \u25968 \u25454 \u24050 \u22797 \u21046 \u21040 \u21098 \u36148 \u26495 ');\
    \});\
\
    // Initialize with one empty row\
    addRow();\
    updateTotals();\
</script>\
