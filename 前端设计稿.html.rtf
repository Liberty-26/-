            if (isMockEnabled || previewImage.src) \{\
                populateMockData();\
            \}\
        \}, 1500);\
    \});\
\
    function populateMockData() \{\
        const mockData = [\
            \{ type: '\uc0\u34746 \u32441 \u38050  HRB400E', spec: '\u934 14*12m', unit: '\u21544 ', qty: 5.250, price: 3950 \},\
            \{ type: '\uc0\u34746 \u32441 \u38050  HRB400E', spec: '\u934 16*12m', unit: '\u21544 ', qty: 12.840, price: 3920 \},\
            \{ type: '\uc0\u30424 \u34746  HRB400E', spec: '\u934 8', unit: '\u21544 ', qty: 3.120, price: 4150 \}\
        ];\
        \
        tableBody.innerHTML = '';\
        mockData.forEach((item, index) => addRow(item, index + 1));\
        updateTotals();\
    \}\
\
    // Table Management\
    function addRow(data = \{ type: '', spec: '', unit: '\uc0\u21544 ', qty: 0, price: 0 \}, index = null) \{\
        const idx = index || tableBody.children.length + 1;\
        const row = document.createElement('tr');\
        row.className = 'border-b border-outline-variant/30 group';\
        row.innerHTML = `\
            <td class="p-2 text-table-cell font-data-mono">$\{idx\}</td>\
            <td class="p-2"><input type="text" class="table-input w-full bg-transparent p-1 text-table-cell border-none rounded" value="$\{data.type\}" placeholder="\uc0\u36755 \u20837 \u21697 \u31181 "></td>\
            <td class="p-2"><input type="text" class="table-input w-full bg-transparent p-1 text-table-cell border-none rounded" value="$\{data.spec\}" placeholder="\uc0\u36755 \u20837 \u35268 \u26684 "></td>\
            <td class="p-2"><input type="text" class="table-input w-full bg-transparent p-1 text-table-cell border-none rounded text-center" value="$\{data.unit\}"></td>\
            <td class="p-2"><input type="number" class="table-input qty-input w-full bg-transparent p-1 text-table-cell border-none rounded text-right font-data-mono" value="$\{data.qty\}"></td>\
            <td class="p-2"><input type="number" class="table-input price-input w-full bg-transparent p-1 text-table-cell border-none rounded text-right font-data-mono" value="$\{data.price\}"></td>\
            <td class="p-2 text-right text-table-cell font-data-mono font-bold amount-cell">0.00</td>\
            <td class="p-2 text-center opacity-0 group-hover:opacity-100 transition-opacity">\
                <button class="remove-row text-error/60 hover:text-error" title="\uc0\u31227 \u38500 \u34892 "><span class="material-symbols-outlined text-sm">remove_circle</span></button>\
            </td>\
        `;\
        \
        tableBody.appendChild(row);\
        bindRowEvents(row);\
        calculateRow(row);\
    \}\
\
    function bindRowEvents(row) \{\
        const qtyInput = row.querySelector('.qty-input');\
        const priceInput = row.querySelector('.price-input');\
        const removeBtn = row.querySelector('.remove-row');\
        \
        const handleUpdate = () => \{\
            calculateRow(row);\
            updateTotals();\
        \};\
\
        qtyInput.addEventListener('input', handleUpdate);\
        priceInput.addEventListener('input', handleUpdate);\
        removeBtn.addEventListener('click', () => \{\
            row.remove();\
            reindexTable();\
            updateTotals();\
        \});\
    \}\
\
    function calculateRow(row) \{\
        const qty = parseFloat(row.querySelector('.qty-input').value) || 0;\
        const price = parseFloat(row.querySelector('.price-input').value) || 0;\
        const amountCell = row.querySelector('.amount-cell');\
        const amount = qty * price;\
        amountCell.innerText = amount.toFixed(2);\
    \}\
\
    function updateTotals() \{\
        let total = 0;\
        document.querySelectorAll('.amount-cell').forEach(cell => \{\
            total += parseFloat(cell.innerText) || 0;\
        \});\
        totalAmountEl.innerText = total.toLocaleString('zh-CN', \{ minimumFractionDigits: 2 \});\
    \}\
\
    function reindexTable() \{\
        Array.from(tableBody.children).forEach((row, i) => \{\
            row.cells[0].innerText = i + 1;\
        \});\
    \}\
\
    addRowBtn.addEventListener('click', () => addRow());\
    clearTableBtn.addEventListener('click', () => \{\
        if (confirm('\uc0\u30830 \u23450 \u35201 \u28165 \u38500 \u25152 \u26377 \u35782 \u21035 \u25968 \u25454 \u21527 \u65311 ')) \{\
