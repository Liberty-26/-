    document.addEventListener('focusout', (e) => \{\
        if (e.target.classList.contains('table-input')) \{\
            e.target.classList.add('saved-flash');\
            setTimeout(() => e.target.classList.remove('saved-flash'), 800);\
        \}\
    \});\
\
    document.addEventListener('keydown', (e) => \{\
        if (!e.target.classList.contains('table-input')) return;\
\
        const cell = e.target.closest('td');\
        const row = cell.closest('tr');\
        const colIndex = Array.from(row.cells).indexOf(cell);\
\
        if (e.key === 'Enter') \{\
            e.preventDefault();\
            const nextRow = row.nextElementSibling;\
            if (nextRow && nextRow.cells[colIndex]) \{\
                const nextInput = nextRow.cells[colIndex].querySelector('.table-input');\
                if (nextInput) nextInput.focus();\
            \}\
        \}\
    \});\
</script>\
