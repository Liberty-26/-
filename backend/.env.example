# SteelDigitize Pro 配置文件
# 复制为 .env 并填入实际值

# ---- 识图模型（用于拍照识别送货单）----
VISION_API_KEY=sk-xxxxxxxxxxxxxxxx
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# ---- Agent 模型（用于自动写入对账单）----
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENT_API_BASE=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

# ---- 数据库与存储（一般无需修改）----
DATABASE_PATH=./data.db
UPLOAD_DIR=./uploads
