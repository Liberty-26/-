          "type": "string"
        },
        "package_id": {
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
